# Neon — direct (non-pooled) endpoint. Migrations and tests need session-level features.
DATABASE_URL=postgresql://USER:PASSWORD@ep-fancy-unit-a5sxtm1v.us-east-2.aws.neon.tech/neondb?sslmode=require
# Neon — pooled endpoint, for the running app.
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@ep-fancy-unit-a5sxtm1v-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# The agent connects as the restricted clinic_agent role (db/002_agent_role.sql),
# so its grants bind at runtime. Pick one password and use it in both lines.
AGENT_DATABASE_URL=postgresql://USER:PASSWORD@ep-fancy-unit-a5sxtm1v.us-east-2.aws.neon.tech/neondb?sslmode=require
AGENT_DB_PASSWORD=CHANGE-ME

# A separate database for `npm test` — the suite truncates every table it touches.
# On Neon: Databases → New database → neondb_test.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-fancy-unit-a5sxtm1v.us-east-2.aws.neon.tech/neondb_test?sslmode=require

# Intent classification. Without this the agent escalates every message to a
# human rather than guessing — see src/lib/agent/intent.ts.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# 32+ characters. Rotate for anything other than local development.
SESSION_SECRET=CHANGEME-at-least-32-characters-long

# Set after `npm run seed` prints it.
CLINIC_ID=

# Unset means outbound messages are logged, not sent — that is what makes
# `npm run sim` work with no Meta account.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# STAFF_NOTIFY_PHONE=
