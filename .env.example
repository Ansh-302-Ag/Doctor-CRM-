# Neon — direct (non-pooled) endpoint. Migrations and tests need session-level features.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require
# Neon — pooled endpoint, for the running app.
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require

# The agent connects as the restricted clinic_agent role (db/002_agent_role.sql),
# so its grants bind at runtime. Pick one password and use it in both lines.
AGENT_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require
AGENT_DB_PASSWORD=CHANGE-ME

# A separate database for `npm test` — the suite truncates every table it touches.
# On Neon: Databases → New database → neondb_test.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb_test?sslmode=require

# Intent classification. Without this the agent escalates every message to a
# human rather than guessing — see src/lib/agent/intent.ts.
# ANTHROPIC_API_KEY wins if both this and OPENAI_COMPAT_API_KEY below are set,
# so a production deployment can never silently fall back to the test provider.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Any OpenAI-compatible chat-completions endpoint (Groq, OpenRouter, xAI,
# Together …) is the second classifier provider — use it for testing without
# an Anthropic key. It is picked up only when ANTHROPIC_API_KEY above is
# unset. Not for production. Defaults to Groq serving openai/gpt-oss-20b.
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_MODEL=openai/gpt-oss-20b

# Public base URL of this app. Prescription links sent to patients are built
# from it (https://clinic.example.com/r/...). REQUIRED in production — creating
# a link throws without it; dev and tests default to http://localhost:3000.
APP_URL=http://localhost:3000

# 32+ characters. Rotate for anything other than local development.
SESSION_SECRET=CHANGEME-at-least-32-characters-long

# Set after `npm run seed` prints it.
CLINIC_ID=

# Shared secret for the schedulers. Point a cron at
# GET /api/cron/reminders every 15 minutes and GET /api/cron/purge daily,
# both with `Authorization: Bearer <this>`.
CRON_SECRET=

# Bearer secret for the inbound-call voice agent (Sarvam) calling
# POST /api/voice/availability and POST /api/voice/book. Unset = both refuse.
VOICE_API_SECRET=

# Unset means outbound messages are logged, not sent — that is what makes
# `npm run sim` work with no Meta account.
#
# PRODUCTION (Meta Cloud API). All four come from the Meta app dashboard.
# WHATSAPP_TOKEN=                  # send: System User bearer token (not the 24h temporary one)
# WHATSAPP_PHONE_NUMBER_ID=        # send: the number messages come from
# WHATSAPP_APP_SECRET=             # inbound: the webhook HMAC secret
# WHATSAPP_VERIFY_TOKEN=           # inbound: Meta's subscription handshake only
# STAFF_NOTIFY_PHONE=              # where escalations page a human
